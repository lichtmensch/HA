    "config": {
      "views": [
        {
          "title": "Haussteuerung",
          "path": "zuhause",
          "icon": "mdi:home-outline",
          "type": "sections",
          "max_columns": 1,
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Wetter draußen",
                  "icon": "mdi:weather-partly-cloudy"
                },
                {
                  "type": "horizontal-stack",
                  "cards": [
                    {
                      "type": "custom:button-card",
                      "entity": "sensor.aussentemperatur_mit_24h_prognose",
                      "name": "Außen",
                      "icon": "mdi:thermometer",
                      "show_state": false,
                      "tap_action": {
                        "action": "more-info"
                      },
                      "custom_fields": {
                        "current": "[[[ const p = String(entity.state).split('·'); return p[0]?.trim() || '–'; ]]]",
                        "detail": "[[[ const p = String(entity.state).split('·'); return p[1] ? `24 h: ${p[1].trim()}` : '24-h-Prognose nicht verfügbar'; ]]]"
                      },
                      "styles": {
                        "card": [
                          { "height": "112px" },
                          { "padding": "12px" }
                        ],
                        "grid": [
                          { "grid-template-areas": "\"n i\" \"current current\" \"detail detail\"" },
                          { "grid-template-columns": "1fr 28px" },
                          { "grid-template-rows": "22px 1fr 20px" }
                        ],
                        "name": [
                          { "justify-self": "start" },
                          { "font-size": "13px" },
                          { "font-weight": "500" }
                        ],
                        "icon": [
                          { "width": "24px" },
                          { "color": "var(--primary-color)" }
                        ],
                        "custom_fields": {
                          "current": [
                            { "justify-self": "start" },
                            { "align-self": "center" },
                            { "font-size": "24px" },
                            { "font-weight": "600" }
                          ],
                          "detail": [
                            { "justify-self": "start" },
                            { "font-size": "11px" },
                            { "color": "var(--secondary-text-color)" },
                            { "white-space": "nowrap" }
