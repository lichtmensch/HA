                  }
                },
                {
                  "type": "custom:button-card",
                  "entity": "sensor.wetter_flur_tageszeiten",
                  "show_icon": false,
                  "show_state": false,
                  "show_label": true,
                  "name": "[[[ const d=new Date(); const tomorrow=d.getHours()>=22; if(tomorrow)d.setDate(d.getDate()+1); const text=new Intl.DateTimeFormat('de-DE',{weekday:'long',day:'2-digit',month:'long'}).format(d); return `${tomorrow?'Morgen':'Heute'} · ${text.charAt(0).toUpperCase()+text.slice(1)}`; ]]]",
                  "label": "[[[ const tomorrow=new Date().getHours()>=22; const names={sunny:'Sonnig',partlycloudy:'Teilweise bewölkt',cloudy:'Bewölkt',rainy:'Regen',pouring:'Starker Regen','clear-night':'Klare Nacht',fog:'Nebel',snowy:'Schnee','snowy-rainy':'Schneeregen',lightning:'Gewitter','lightning-rainy':'Gewitterregen',windy:'Windig'}; if(!tomorrow){const w=states['weather.forecast_home'];const t=w?.attributes?.temperature;return `${names[w?.state]||w?.state||'–'}${t!==undefined?' · '+Number(t).toLocaleString('de-DE',{maximumFractionDigits:1})+' °C':''}`;} const periods=entity?.attributes?.periods||[]; const midday=periods.find(p=>p.label==='Mittags')||periods[0]||{}; return `${names[midday.condition]||midday.condition||'–'}${midday.temperature!=null?' · '+Number(midday.temperature).toLocaleString('de-DE',{maximumFractionDigits:1})+' °C':''}`; ]]]",
                  "custom_fields": {
                    "periods": "[[[ const items=entity?.attributes?.periods || []; const symbols={sunny:'☀️',partlycloudy:'🌤️',cloudy:'☁️',rainy:'🌧️',pouring:'🌧️','clear-night':'🌙',fog:'🌫️',snowy:'🌨️','snowy-rainy':'🌨️',lightning:'⛈️','lightning-rainy':'⛈️',windy:'🌬️'}; return `<div style=\"display:grid;grid-template-columns:repeat(4,1fr);width:100%;gap:0\">${items.map((p,i)=>`<div style=\"text-align:center;${i<3?'border-right:1px solid var(--divider-color);':''}\"><div style=\"font-size:13px;color:var(--secondary-text-color);margin-bottom:2px\">${p.label}</div><div style=\"font-size:28px;line-height:30px\">${symbols[p.condition]||'🌥️'}</div><div style=\"font-size:19px;font-weight:600;margin-top:1px\">${p.temperature!=null?Number(p.temperature).toLocaleString('de-DE',{maximumFractionDigits:1})+'°':'–'}</div><div style=\"font-size:11px;color:var(--secondary-text-color)\">${p.precipitation_probability!=null?'Regen '+Math.round(p.precipitation_probability)+' %':p.precipitation!=null?'Regen '+Number(p.precipitation).toLocaleString('de-DE',{maximumFractionDigits:1})+' mm':'Zeitraum vorbei'}</div></div>`).join('')}</div>`; ]]]"
                  },
                  "tap_action": {
                    "action": "more-info"
                  },
                  "styles": {
                    "card": [
                      {
                        "height": "140px"
                      },
                      {
                        "padding": "9px 12px"
                      },
                      {
                        "border-radius": "16px"
                      }
                    ],
                    "grid": [
                      {
                        "grid-template-areas": "'n' 'l' 'periods'"
                      },
                      {
                        "grid-template-rows": "24px 22px 1fr"
                      }
                    ],
                    "name": [
                      {
                        "justify-self": "start"
                      },
                      {
                        "font-size": "18px"
                      },
                      {
                        "font-weight": "600"
                      }
                    ],
                    "label": [
                      {
                        "justify-self": "start"
                      },
                      {
                        "font-size": "13px"
                      },
                      {
                        "color": "var(--secondary-text-color)"
                      }
                    ],
                    "custom_fields": [
                      {
                        "periods": [
                          {
                            "width": "100%"
                          },
                          {
                            "align-self": "end"
                          }
                        ]
                      }
                    ]
                  },
                  "grid_options": {
                    "columns": 12,
                    "rows": 3
                  }
                },
                {
                  "type": "custom:button-card",
                  "entity": "sensor.wetter_nachste_tage",
                  "show_icon": false,
                  "show_name": false,
                  "show_state": false,
                  "custom_fields": {
                    "days": "[[[ const items=entity?.attributes?.days || []; const symbols={sunny:'☀️',partlycloudy:'🌤️',cloudy:'☁️',rainy:'🌧️',pouring:'🌧️','clear-night':'🌙',fog:'🌫️',snowy:'🌨️','snowy-rainy':'🌨️',lightning:'⛈️','lightning-rainy':'⛈️',windy:'🌬️'}; return `<div style=\"display:grid;grid-template-columns:repeat(5,1fr);width:100%\">${items.map(p=>{const d=new Date(p.datetime);const day=new Intl.DateTimeFormat('de-DE',{weekday:'short'}).format(d);return `<div style=\"text-align:center\"><div style=\"font-size:13px;color:var(--secondary-text-color)\">${day}</div><div style=\"font-size:24px;line-height:28px;margin:2px 0\">${symbols[p.condition]||'🌥️'}</div><div style=\"font-size:15px;font-weight:600\">${p.temperature!=null?Math.round(p.temperature)+'°':'–'}</div><div style=\"font-size:11px;color:var(--secondary-text-color)\">${p.templow!=null?Math.round(p.templow)+'°':'–'}</div></div>`}).join('')}</div>`; ]]]"
                  },
                  "tap_action": {
                    "action": "more-info"
                  },
                  "styles": {
