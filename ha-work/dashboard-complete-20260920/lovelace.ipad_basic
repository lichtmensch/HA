                      {
                        "width": "72px"
                      },
                      {
                        "color": "[[[ const c=states['weather.forecast_home']?.state; const m={clear:'#FFD54F',sunny:'#FFD54F',partlycloudy:'#FFE082',cloudy:'#CFD8DC',rainy:'#64B5F6',pouring:'#42A5F5',snowy:'#E3F2FD',fog:'#B0BEC5',windy:'#80CBC4', 'windy-variant':'#80CBC4'}; return m[c]||'#CFD8DC'; ]]]"
                      },
