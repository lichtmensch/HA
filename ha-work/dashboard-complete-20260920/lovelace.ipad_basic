          "max_columns": 2,
          "dense_section_placement": true,
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:button-card",
                  "section_mode": true,
                  "entity": "weather.forecast_home",
                  "triggers_update": [
                    "weather.forecast_home"
                  ],
                  "show_icon": true,
                  "icon": "[[[ const c=states['weather.forecast_home']?.state; const m={clear:'mdi:weather-sunny',sunny:'mdi:weather-sunny',partlycloudy:'mdi:weather-partly-cloudy',cloudy:'mdi:weather-cloudy',rainy:'mdi:weather-rainy',pouring:'mdi:weather-pouring',snowy:'mdi:weather-snowy',fog:'mdi:weather-fog',windy:'mdi:weather-windy','windy-variant':'mdi:weather-windy-variant'}; return m[c]||'mdi:weather-cloudy'; ]]]",
                  "show_state": false,
                  "custom_fields": {
                    "weather": "[[[ const c=states['weather.forecast_home']?.state; const symbols={sunny:'☀️',partlycloudy:'🌤️',cloudy:'☁️',rainy:'🌧️',pouring:'🌧️','clear-night':'🌙',fog:'🌫️',snowy:'🌨️','snowy-rainy':'🌨️',lightning:'⛈️','lightning-rainy':'⛈️',windy:'🌬️'}; return `<span style=\"font-size:64px;line-height:1\">${symbols[c]||'🌥️'}</span>`; ]]]"
                  },
                  "show_label": true,
                  "update_timer": "1s",
                  "name": "[[[ return new Intl.DateTimeFormat('de-DE', {hour:'2-digit', minute:'2-digit'}).format(new Date()); ]]]",
                  "label": "[[[ const text = new Intl.DateTimeFormat('de-DE', {weekday:'long', day:'2-digit', month:'long'}).format(new Date()); return text.charAt(0).toUpperCase() + text.slice(1); ]]]",
                  "tap_action": {
                    "action": "none"
                  },
                  "styles": {
                    "card": [
                      {
                        "height": "160px"
                      },
                      {
                        "padding": "16px 22px"
                      },
                      {
                        "border-radius": "20px"
                      },
                      {
                        "background": "linear-gradient(135deg, rgba(35,78,112,0.96), rgba(18,34,52,0.96))"
                      }
                    ],
